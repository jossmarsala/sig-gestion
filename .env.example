# Where the app reads data from:
#   mock -> MSW intercepts fetch and serves fixtures shaped like the real DB
#   api  -> real Express backend at VITE_API_URL
# Can be overridden at runtime without rebuilding:
#   localStorage.setItem('aguamarina:data-source', 'api')  (or the dev badge)
VITE_DATA_SOURCE=mock

# Express origin. Routes already include the /api prefix.
VITE_API_URL=http://localhost:3001

# `id_vendedor` used for POST /api/ventas. The Supabase auth profile is not
# linked to the `usuario` table yet, so this numeric id is used instead.
VITE_DEFAULT_VENDEDOR_ID=1

# Simulated latency for mock responses (ms)
VITE_MOCK_LATENCY_MS=350

# Show the data-source switch ("Datos simulados" / "API real") in production
# builds. Leave unset to keep it hidden outside development.
# VITE_SHOW_DATA_SOURCE_TOGGLE=true

# Supabase (used by AuthContext; irrelevant while using the dev fallback profile)
# The public key can be provided with either name (Supabase now calls it
# "publishable key"). Never put the service_role/secret key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
